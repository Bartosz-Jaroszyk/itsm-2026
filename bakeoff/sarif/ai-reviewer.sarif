{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-reviewer",
          "informationUri": "https://github.com/swasik/itsm-2026-template",
          "rules": [
            {
              "id": "shell-command-injection",
              "name": "shell-command-injection",
              "shortDescription": {
                "text": "shell-command-injection"
              },
              "properties": {
                "tags": [
                  "CWE-78"
                ]
              }
            },
            {
              "id": "sql-query-injection",
              "name": "sql-query-injection",
              "shortDescription": {
                "text": "sql-query-injection"
              },
              "properties": {
                "tags": [
                  "CWE-89"
                ]
              }
            },
            {
              "id": "customer-webhook-ssrf",
              "name": "customer-webhook-ssrf",
              "shortDescription": {
                "text": "customer-webhook-ssrf"
              },
              "properties": {
                "tags": [
                  "CWE-918"
                ]
              }
            },
            {
              "id": "tls-certificate-verification-disabled",
              "name": "tls-certificate-verification-disabled",
              "shortDescription": {
                "text": "tls-certificate-verification-disabled"
              },
              "properties": {
                "tags": [
                  "CWE-295"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "shell-command-injection",
          "level": "warning",
          "message": {
            "text": "Untrusted ticket_id is interpolated into a shell command executed with shell=True, allowing command execution through a crafted ticket ID."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/attachment_export.py"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 11
                }
              }
            }
          ],
          "properties": {
            "class": "injection"
          }
        },
        {
          "ruleId": "sql-query-injection",
          "level": "warning",
          "message": {
            "text": "needle is interpolated directly into SQL, allowing crafted search input to alter the query and expose tickets beyond the intended title match."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/ticket_search.py"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 8
                }
              }
            }
          ],
          "properties": {
            "class": "injection"
          }
        },
        {
          "ruleId": "customer-webhook-ssrf",
          "level": "warning",
          "message": {
            "text": "A customer-configured callback URL is used for an outbound POST without destination restrictions, allowing requests to loopback or private-network services."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/webhook_relay.py"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6
                }
              }
            }
          ],
          "properties": {
            "class": "ssrf"
          }
        },
        {
          "ruleId": "tls-certificate-verification-disabled",
          "level": "warning",
          "message": {
            "text": "TLS certificate verification is disabled, allowing a network attacker to intercept the request and substitute the returned avatar bytes."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/avatar_fetch.py"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6
                }
              }
            }
          ],
          "properties": {
            "class": "insecure-transport"
          }
        }
      ],
      "properties": {
        "model": "Copilot security-review agent (model identifier not reported)",
        "route": "local"
      }
    }
  ]
}
